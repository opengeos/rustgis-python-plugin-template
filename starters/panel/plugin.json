{
  "id": "my-plugin",
  "name": "My Plugin",
  "version": "0.1.0",
  "description": "A panel beside the map: step through the map's layers, see each one's features and fields, zoom to it and show or hide it.",
  "author": "Your Name",
  "homepage": "https://github.com/you/my-plugin",
  "license": "MIT",
  "runtime": "process",
  "python": { "version": "3.12", "requirements": "requirements.txt" },
  "run": ["python", "main.py"],
  "minRustgisVersion": "0.3.0",
  "permissions": ["edit"],
  "commands": [
    { "id": "panel-state", "label": "Refresh", "help": "Read the map's layers again.", "icon": "update" },
    { "id": "show-layer", "label": "Show\nLayer", "help": "Show the chosen layer's features and fields.", "icon": "identify" },
    { "id": "zoom-to", "label": "Zoom To", "help": "Zoom to the chosen layer.", "icon": "zoom_full" },
    { "id": "toggle-visibility", "label": "Show/Hide", "help": "Show or hide the chosen layer.", "icon": "eye" }
  ],
  "panel": {
    "title": "My Plugin",
    "icon": "contents",
    "help": "Step through the map's layers.",
    "state": "panel-state",
    "items": [
      { "kind": "checkbox", "id": "vector-only", "label": "Vector layers only", "command": "panel-state" },
      { "kind": "slider", "id": "layer", "label": "Layer", "min": 0, "max": 999, "steps": true, "command": "show-layer" },
      { "kind": "text", "id": "summary", "label": "Selected layer", "text": "Open the panel to read the map." },
      { "kind": "button", "command": "zoom-to" },
      { "kind": "button", "command": "toggle-visibility" },
      { "kind": "text", "id": "fields", "label": "Fields" }
    ]
  },
  "i18n": {
    "de": {
      "My Plugin": "Mein Plugin",
      "Step through the map's layers.": "Die Ebenen der Karte durchgehen.",
      "Vector layers only": "Nur Vektorebenen",
      "Layer": "Ebene",
      "Selected layer": "Gewählte Ebene",
      "Open the panel to read the map.": "Öffnen Sie das Panel, um die Karte zu lesen.",
      "Fields": "Felder",
      "Refresh": "Aktualisieren",
      "Zoom To": "Zoomen auf",
      "Show/Hide": "Ein/Aus",
      "{features} features, {geometry}, {visible}": "{features} Features, {geometry}, {visible}",
      "visible": "sichtbar",
      "hidden": "ausgeblendet",
      "The map has no layers.": "Die Karte hat keine Ebenen."
    }
  }
}
